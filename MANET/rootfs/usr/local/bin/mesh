#!/bin/bash
# mesh — CLI tool for MANET node management
# Talks to the local manet-ctrl API over HTTPS on loopback.
#
# Reads work for everyone. Writes authenticate with the token manet-ctrl
# keeps in a root-only file (see clitoken.go), so they need root:
# "sudo mesh ...". Secrets never travel on a command line: request bodies
# reach curl on stdin, the token through a header file, and values reach
# python through the environment (/proc/<pid>/environ is owner-only).

set -euo pipefail
API="${MESH_API:-https://127.0.0.1/api}"
TOKEN_FILE="${MESH_TOKEN_FILE:-/run/manet-ctrl/cli-token}"
TOKEN=""
if [[ -r "$TOKEN_FILE" ]]; then
  TOKEN=$(<"$TOKEN_FILE")
fi

usage() {
  cat <<'USAGE'
Usage: mesh <command> [args...]

Node
  status                         Node summary (hostname, IP, uptime, radios, battery)
  nodes                          All mesh nodes table
  gps                            GPS fix status and coordinates
  version                        Software release and manet-ctrl version
  hostname <prefix>              Set the hostname prefix (applied immediately)
  reboot                         Reboot this node

Config (this node only)
  config show                    Show current settings
  config get <key>               Get a single value
  config set <key> <value>       Set a value (applied immediately)
  config keys                    List all configurable keys

Passwords (prompted, never on the command line)
  password admin                 Stage a new admin password fleet-wide
  password mesh-key              Stage a new mesh SAE key fleet-wide
  password ap-key [--fleet]      Set the LAN AP password on this node (or fleet-wide)

Radio
  radio info                     Radio interfaces: driver, channel, TX power, MCS
  radio channels [halow|5ghz]    Legal channels for this node's region
  radio halow <channel|auto> [bw]   Set the HaLow channel (bw: 1MHz 2MHz 4MHz 8MHz)
  radio 5ghz <channel|default>   Pin the 5GHz mesh channel (acs=n)
  radio txpower <iface> <dbm>    Set TX power
  radio interface <iface> up|down   Bring an interface up/down

Fleet (all nodes)
  fleet status                   Staged package and which nodes acknowledged it
  fleet set <key>=<value>...     Stage settings for the whole fleet
  fleet activate [--force]       Apply the staged package on every node
  fleet cancel                   Drop the staged package

Updates
  update status                  Installed vs available software/overlay
  update now <software|overlay|both>   Download and apply now (reboots)

Services
  services                       List services and status
  service <start|stop|restart> <name>

Other
  perf ping <target>             Ping a peer node
  help                           Show this help

Writes need root: run them with sudo.
USAGE
}

die() { echo "mesh: $*" >&2; exit 1; }

# api METHOD PATH [JSON] — prints the response body; dies on transport
# errors and on HTTP 401 (with a hint); returns 1 on other HTTP errors.
token_header() {
  if [[ -n "$TOKEN" ]]; then printf 'X-Manet-CLI-Token: %s\n' "$TOKEN"; fi
}

api() {
  local method=$1 path=$2 body=${3:-} out code
  local args=(-sk -X "$method" -w $'\n%{http_code}')
  if [[ -n "$body" ]]; then
    args+=(-H 'Content-Type: application/json' --data-binary @-)
  fi
  # The <(...) must sit on curl's own command line to still be open.
  out=$(printf '%s' "$body" | curl "${args[@]}" -H @<(token_header) "$API$path") ||
    die "cannot reach manet-ctrl API"
  code=${out##*$'\n'}
  out=${out%$'\n'*}
  if [[ "$code" == 401 ]]; then
    [[ -n "$TOKEN" ]] || die "this needs root on a node with login enabled: sudo mesh $CMDLINE"
    die "authentication refused (manet-ctrl restarted? try again)"
  fi
  printf '%s\n' "$out"
  [[ "$code" == 2* ]]
}

# py MODE [ARGS...] — every pretty-print. kv MODE k v ... — every JSON
# build from key/value pairs, handed over in MESH_KV, never in argv.
py() { python3 -c "$PY" "$@"; }
kv() { local mode=$1; shift; MESH_KV="$(printf '%s\037' "$@")" python3 -c "$PY" "$mode"; }

read -r -d '' PY <<'EOF' || true
import json, os, sys

mode, args = sys.argv[1], sys.argv[2:]

def pairs():
    a = os.environ.get("MESH_KV", "").split("\x1f")[:-1]
    return dict(zip(a[::2], a[1::2]))

def load():
    raw = sys.stdin.read()
    try:
        return json.loads(raw) if raw.strip() else {}
    except ValueError:
        sys.exit("unexpected response: " + raw.strip()[:200])

def result(d, ok_msg):
    if not d.get("ok"):
        sys.exit("Error: " + str(d.get("error", "unknown")))
    if ok_msg:
        print(ok_msg)
    for w in d.get("warnings") or []:
        print("Warning: " + w, file=sys.stderr)

if mode == "obj":                       # {"k":"v",...}
    print(json.dumps(pairs()))
elif mode == "config":                  # {"config":{"k":"v",...}}
    print(json.dumps({"config": pairs()}))
elif mode == "fleet-merge":
    # stdin: /api/admin/preferences. Merge the pairs into mesh_config: the
    # same document the web UI's Fleet tab saves before it stages, so a
    # later stage from the UI keeps this change instead of reverting it.
    p = load()
    mc = p.get("mesh_config") or {}
    mc.update(pairs())
    p["mesh_config"] = mc
    print(json.dumps(p))
elif mode == "fleet-stage-body":
    print(json.dumps({"config": load().get("mesh_config") or {}}))
elif mode == "txpower":
    try:
        dbm = float(args[1])
    except ValueError:
        sys.exit("dbm must be a number")
    print(json.dumps({"iface": args[0], "dbm": dbm}))
elif mode == "activate":
    print(json.dumps({"force": args[0] == "1"}))

elif mode == "result":
    result(load(), args[0] if args else "")

elif mode == "txpower-result":          # report what the radio took, not the request
    d = load()
    result(d, "")
    iface, want, got = d.get("iface", "?"), d.get("dbm", "?"), d.get("actual_dbm") or ""
    try:
        matched = abs(float(got) - float(want)) < 0.5
    except ValueError:
        matched = False
    if matched:
        print(f"TX power set to {got} dBm on {iface}")
    elif got:
        print(f"Requested {want} dBm on {iface}; the radio reports {got} dBm (driver/firmware limit)")
    else:
        print(f"Requested {want} dBm on {iface}; the radio reports no power value")

elif mode == "config-set-result":
    d = load()
    if d.get("ok") and not d.get("saved"):
        sys.exit("Error: not a configurable key (see: mesh config keys)")
    result(d, "Saved: " + ", ".join(sorted(d.get("saved") or [])))
    for k in sorted(d.get("applied") or {}):
        print("  Applied: " + k)

elif mode == "status":
    d = load()
    print(f"Hostname:  {d.get('hostname', '--')}")
    print(f"IP:        {d.get('ip', '--')}")
    print(f"MAC:       {d.get('mac', '--')}")
    print(f"Uptime:    {d.get('uptime', '--')}")
    print(f"EUD Mode:  {d.get('eud_mode', '--')}")
    print(f"AP SSID:   {d.get('ap_ssid', '--')}")
    print(f"Mesh SSID: {d.get('mesh_ssid', '--')}")
    bat = d.get('battery')
    if bat and isinstance(bat, dict):
        print(f"Battery:   {bat.get('percentage', '--')}% ({bat.get('status', '')})")
    else:
        print('Battery:   Not detected')
    for r in d.get('interfaces', []):
        if r.get('role') not in ('mesh', 'ap'):
            continue
        freq = f" ({r.get('freq_mhz')} MHz)" if r.get('freq_mhz') else ''
        tx = f"{r.get('txpower_dbm')} dBm" if r.get('txpower_dbm') else '--'
        print(f"Radio:     {r['name']} [{r.get('state','?')}] {r.get('driver','')} ch{r.get('channel','')}{freq} tx={tx}")

elif mode == "nodes":
    nodes = load().get('nodes', [])
    if not nodes:
        print('No nodes found')
        sys.exit(0)
    fmt = '{:<24s} {:<16s} {:<8s} {:<6s} {:<10s}'
    print(fmt.format('HOSTNAME', 'IP', 'TQ', 'HOPS', 'LAST SEEN'))
    print('-' * 68)
    for n in sorted(nodes, key=lambda x: x.get('hostname', '')):
        me = ' (me)' if n.get('is_me') else ''
        print(fmt.format((n.get('hostname', '?') + me)[:24], (n.get('ip') or '--')[:16],
                         str(n.get('tq', '--')), str(n.get('hop_count', '--')), str(n.get('last_seen_ago', '--'))))

elif mode == "config-show":
    cfg = load().get('current_config', {})
    for k in sorted(cfg):
        print(f'{k:30s} = {cfg[k]}')

elif mode == "config-get":
    cfg = load().get('current_config', {})
    if args[0] not in cfg:
        sys.exit(f'Key not found: {args[0]} (secrets need root: sudo mesh config get ...)')
    print(cfg[args[0]])

elif mode == "config-keys":
    for k in load().get('keys', []):
        print('{:<22s} {}'.format(k.get('key', ''), k.get('description', '')))

elif mode == "radio-info":
    radios = [i for i in load().get('interfaces', []) if i.get('role') in ('mesh', 'ap') or i.get('driver')]
    if not radios:
        print('No radios detected')
    for r in radios:
        print(f"--- {r['name']} [{r.get('state','?')}] ---")
        print(f"  Role:      {r.get('role', '--')}")
        print(f"  Driver:    {r.get('driver', '--')}")
        for key, label, unit in (('channel', 'Channel', ''), ('freq_mhz', 'Frequency', ' MHz'),
                                 ('halow_bw', 'Bandwidth', ''), ('txpower_dbm', 'TX Power', ' dBm'),
                                 ('tx_mcs', 'TX MCS', ''), ('rx_mcs', 'RX MCS', '')):
            if r.get(key):
                print(f"  {label + ':':<10} {r[key]}{unit}")
        if r.get('addrs'):
            print(f"  Addresses: {', '.join(r['addrs'])}")
        if r.get('faults'):
            print(f"  Faults:    {', '.join(r['faults'])}")
        print()

elif mode == "channels":
    d = load()
    print(f"{args[0]} channels (default {d.get('default_channel', '--')}):")
    for c in d.get('channels', []):
        freq = f"  {c['freq_mhz']} MHz" if c.get('freq_mhz') else ''
        print(f"  {c.get('channel')}{freq}")

elif mode == "gps":
    gps = load().get('gps', {})
    if gps and gps.get('available'):
        print("Status:    Fix acquired")
        print(f"Latitude:  {gps.get('lat', '--')}")
        print(f"Longitude: {gps.get('lon', '--')}")
        print(f"Altitude:  {gps.get('alt', '--')} m")
    else:
        print('Status:    No GPS fix or device not connected')

elif mode == "services":
    fmt = '{:<20s} {:<12s} {:<12s} {:<10s}'
    print(fmt.format('SERVICE', 'STATUS', 'CATEGORY', 'ENABLED'))
    print('-' * 56)
    for s in load().get('services', []):
        print(fmt.format(s.get('name', '?')[:20], s.get('status', '?'), s.get('category', '?'),
                         'yes' if s.get('enabled') else 'no'))

elif mode == "fleet-status":
    d = load()
    pending = d.get('pending')
    if not pending:
        print('No fleet package staged.')
        sys.exit(0)
    print(f"Staged version: {pending.get('version', '--')}")
    keys = sorted((pending.get('config') or {}).keys())
    print("Keys:           " + (", ".join(keys) or "--"))
    ack = d.get('ack_status') or {}
    if ack:
        print(f"Acknowledged:   {ack.get('acked', 0)}/{ack.get('total', 0)}")
        for n in ack.get('missing') or []:
            print(f"  waiting on {n}")
        if ack.get('dangerous_keys'):
            print("Dangerous keys: " + ", ".join(ack['dangerous_keys']))

elif mode == "update-status":
    d = load()
    for ch in ('software', 'overlay'):
        c = d.get(ch) or {}
        avail = 'update available' if c.get('available') else 'up to date'
        print(f"{ch.capitalize() + ':':<10} {c.get('local') or '--'} -> {c.get('remote') or '--'} ({avail})")
    print(f"Uplink:    {d.get('uplink_type', '--')}, {d.get('uplink_mbps', 0)} Mbps")
    if d.get('phase'):
        print(f"Phase:     {d['phase']}")

elif mode == "version":
    print(f"manet-ctrl: {load().get('version', '--')}")
else:
    sys.exit("internal: unknown mode " + mode)
EOF

need() { [[ $1 -ge $2 ]] || { echo "Usage: mesh $3" >&2; exit 1; }; }

# config_save k v ... — one /api/admin/save with these keys, this node only.
config_save() {
  api POST /admin/save "$(kv config "$@")" | py config-set-result
}

# fleet_set k v ... — merge into the fleet preferences and stage them,
# exactly what the web UI's Fleet tab does; mesh fleet activate applies.
fleet_set() {
  local prefs
  prefs=$(api GET /admin/preferences | MESH_KV="$(printf '%s\037' "$@")" python3 -c "$PY" fleet-merge)
  api POST /admin/preferences "$prefs" | py result ""
  api POST /admin/stage "$(printf '%s' "$prefs" | py fleet-stage-body)" |
    py result "Staged for the fleet. Check 'mesh fleet status', then 'sudo mesh fleet activate'."
}

# read_secret LABEL — prompt twice without echo, print the value.
read_secret() {
  local a b
  [[ -t 0 ]] || die "run this in a terminal (the value is prompted, not passed)"
  read -r -s -p "New $1: " a; echo >&2
  read -r -s -p "Repeat $1: " b; echo >&2
  [[ -n "$a" ]] || die "empty value"
  [[ "$a" == "$b" ]] || die "values do not match"
  printf '%s' "$a"
}

CMDLINE="$*"
case "${1:-}" in
  status)   api GET /local | py status ;;
  nodes)    api GET /data | py nodes ;;
  gps)      api GET /local | py gps ;;
  services) api GET /services | py services ;;
  version)
    if [[ -r /etc/manet_release_version.txt ]]; then
      echo "release:    $(</etc/manet_release_version.txt)"
    fi
    api GET /version | py version ;;
  hostname)
    need $# 2 "hostname <prefix>"
    api POST /control/hostname "$(kv obj hostname "$2")" | py result "Hostname prefix set to $2" ;;
  reboot)
    api POST /terminal/reboot '{}' | py result "Rebooting node..." ;;

  config)
    case "${2:-}" in
      show) api GET /admin/status | py config-show ;;
      get)  need $# 3 "config get <key>"; api GET /admin/status | py config-get "$3" ;;
      set)  need $# 4 "config set <key> <value>"; config_save "$3" "$4" ;;
      keys) api GET /config/keys | py config-keys ;;
      *)    echo "Usage: mesh config {show|get|set|keys}" >&2; exit 1 ;;
    esac ;;

  password)
    case "${2:-}" in
      admin)
        echo "The admin password is also the fleet encryption key, so it is staged for every node." >&2
        secret=$(read_secret "admin password"); fleet_set admin_password "$secret" ;;
      mesh-key)
        echo "Every node needs the same mesh key, so it is staged for the whole fleet." >&2
        secret=$(read_secret "mesh key"); fleet_set mesh_key "$secret" ;;
      ap-key)
        secret=$(read_secret "AP password")
        if [[ "${3:-}" == "--fleet" ]]; then fleet_set lan_ap_key "$secret"; else config_save lan_ap_key "$secret"; fi ;;
      *) echo "Usage: mesh password {admin|mesh-key|ap-key [--fleet]}" >&2; exit 1 ;;
    esac ;;

  radio)
    case "${2:-}" in
      info) api GET /local | py radio-info ;;
      channels)
        case "${3:-}" in
          halow) api GET /halow/channels | py channels HaLow ;;
          5ghz)  api GET /mesh5ghz/channels | py channels 5GHz ;;
          "")    api GET /halow/channels | py channels HaLow; api GET /mesh5ghz/channels | py channels 5GHz ;;
          *)     echo "Usage: mesh radio channels [halow|5ghz]" >&2; exit 1 ;;
        esac ;;
      halow)
        need $# 3 "radio halow <channel|auto> [bw]"
        ch=$3; [[ "$ch" == auto ]] && ch=""
        if [[ $# -ge 4 ]]; then config_save halow_channel "$ch" halow_bw "$4"; else config_save halow_channel "$ch"; fi ;;
      5ghz)
        need $# 3 "radio 5ghz <channel|default>"
        ch=$3; [[ "$ch" == default ]] && ch=""
        config_save mesh_5ghz_channel "$ch" ;;
      txpower)
        need $# 4 "radio txpower <iface> <dbm>"
        api POST /control/txpower "$(py txpower "$3" "$4")" | py txpower-result ;;
      interface)
        need $# 4 "radio interface <iface> up|down"
        [[ "$4" == up || "$4" == down ]] || die "state must be up or down"
        api POST /control/interface "$(kv obj iface "$3" state "$4")" | py result "Interface $3 set $4" ;;
      *) echo "Usage: mesh radio {info|channels|halow|5ghz|txpower|interface}" >&2; exit 1 ;;
    esac ;;

  fleet)
    case "${2:-}" in
      status) api GET /admin/status | py fleet-status ;;
      set)
        need $# 3 "fleet set <key>=<value>..."
        pairs=()
        for a in "${@:3}"; do
          [[ "$a" == *=* ]] || die "expected key=value, got: $a"
          pairs+=("${a%%=*}" "${a#*=}")
        done
        fleet_set "${pairs[@]}" ;;
      activate)
        force=0; [[ "${3:-}" == "--force" ]] && force=1
        api POST /admin/activate "$(py activate "$force")" | py result "Fleet package activated." ;;
      cancel) api POST /admin/cancel '{}' | py result "Staged package cancelled." ;;
      *) echo "Usage: mesh fleet {status|set|activate|cancel}" >&2; exit 1 ;;
    esac ;;

  update)
    case "${2:-}" in
      status) api GET /admin/update-status | py update-status ;;
      now)
        need $# 3 "update now <software|overlay|both>"
        api POST /admin/update-now "$(kv obj channel "$3")" | py result "Update started; the node reboots once it is applied." ;;
      *) echo "Usage: mesh update {status|now}" >&2; exit 1 ;;
    esac ;;

  service)
    need $# 3 "service <start|stop|restart> <name>"
    [[ "$2" =~ ^(start|stop|restart)$ ]] || die "action must be start, stop or restart"
    [[ "$3" =~ ^[A-Za-z0-9_.@-]+$ ]] || die "invalid service name"
    api POST "/services/$3" "$(kv obj action "$2")" | py result "$2: $3" ;;

  perf)
    case "${2:-}" in
      ping) need $# 3 "perf ping <target>"; ping -c 10 -- "$3" ;;
      *)    echo "Usage: mesh perf ping <target>" >&2; exit 1 ;;
    esac ;;

  help|--help|-h|"") usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 1 ;;
esac
