#!/bin/bash
# mesh — CLI tool for MANET node management
# Talks to the local manet-ctrl API on port 80

set -euo pipefail
API="https://127.0.0.1/api"
CURL="curl -sfk"

usage() {
  cat <<'USAGE'
Usage: mesh <command> [args...]

Commands:
  status              Node summary (hostname, IP, uptime, radios, battery)
  nodes               All mesh nodes table
  config show         Show current mesh.conf settings
  config get <key>    Get a single config value
  config set <key> <value>   Set a config value (applied immediately)
  config keys         List all configurable keys
  radio info          Radio interfaces — driver, channel, TX power, MCS
  radio txpower <iface> <dbm>   Set TX power
  radio interface <iface> up|down   Bring interface up/down
  gps                 GPS fix status and coordinates
  services            List all services and status
  perf ping <target>  Ping a peer node
  reboot              Reboot this node
  help                Show this help

Config keys:
  node_hostname       Hostname prefix
  mesh_ssid           Mesh network SSID
  mesh_key            Mesh SAE (WPA3) key
  ipv4_network        Mesh IPv4 subnet (e.g. 10.30.2.0/24)
  regulatory_domain   WiFi regulatory domain (US, EU, JP, AU)
  halow_bw            HaLow bandwidth (1MHz, 2MHz, 4MHz, 8MHz)
  multicast_mode      Multicast delivery: flood (default) or optimized
  eud                 EUD mode: wired, wireless, both, auto, none
  lan_ap_ssid         WiFi AP SSID
  lan_ap_key          WiFi AP password
  lan_ap_channel      AP channel (e.g. 36 for 5GHz)
  lan_ap_bw           AP bandwidth (20, 40, 80)
  max_euds_per_node   Max EUD clients per node
  acs                 Auto channel selection (y/n)
  battery_monitor     Battery monitoring (y/n)
  auto_update         Auto update (y/n)
  admin_password      Admin/perf auth key
  gateway             Gateway mode (y/n)
  gateway_nat         NAT masquerade (y/n)
  gateway_mss_clamp   MSS clamping (y/n)
  gateway_bandwidth   Bandwidth advertisement (e.g. 5M/5M)
USAGE
}

cmd_status() {
  local d
  d=$($CURL "$API/local") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f\"Hostname:  {d.get('hostname', '--')}\")
print(f\"IP:        {d.get('ip', '--')}\")
print(f\"MAC:       {d.get('mac', '--')}\")
print(f\"Uptime:    {d.get('uptime', '--')}\")
print(f\"EUD Mode:  {d.get('eud_mode', '--')}\")
print(f\"AP SSID:   {d.get('ap_ssid', '--')}\")
print(f\"Mesh SSID: {d.get('mesh_ssid', '--')}\")
bat = d.get('battery')
if bat and isinstance(bat, dict):
    print(f\"Battery:   {bat.get('percentage', '--')}% ({bat.get('status', '')})\")
else:
    print('Battery:   Not detected')
ifaces = d.get('interfaces', [])
radios = [i for i in ifaces if i.get('role') in ('mesh', 'ap')]
for r in radios:
    ch = r.get('channel', '')
    freq = f\" ({r.get('freq_mhz')} MHz)\" if r.get('freq_mhz') else ''
    tx = f\"{r.get('txpower_dbm', '--')} dBm\" if r.get('txpower_dbm') else '--'
    print(f\"Radio:     {r['name']} [{r.get('state','?')}] {r.get('driver','')} ch{ch}{freq} tx={tx}\")
"
}

cmd_nodes() {
  local d
  d=$($CURL "$API/data") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
nodes = d.get('nodes', [])
if not nodes:
    print('No nodes found')
    sys.exit(0)
fmt = '{:<24s} {:<16s} {:<8s} {:<6s} {:<10s}'
print(fmt.format('HOSTNAME', 'IP', 'TQ', 'HOPS', 'LAST SEEN'))
print('-' * 68)
for n in sorted(nodes, key=lambda x: x.get('hostname', '')):
    tq = str(n.get('tq', '--'))
    hops = str(n.get('hop_count', '--'))
    ls = n.get('last_seen_ago', '--')
    me = ' (me)' if n.get('is_me') else ''
    print(fmt.format(
        (n.get('hostname', '?') + me)[:24],
        (n.get('ip', '--'))[:16],
        tq, hops, str(ls)
    ))
"
}

cmd_config_show() {
  local d
  d=$($CURL "$API/admin/status") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
cfg = d.get('current_config', d.get('config', {}))
if not cfg:
    print('No config data available')
    sys.exit(0)
for k in sorted(cfg.keys()):
    print(f'{k:30s} = {cfg[k]}')
"
}

cmd_config_get() {
  local key=$1
  local d
  d=$($CURL "$API/admin/status") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
cfg = d.get('current_config', d.get('config', {}))
key = '$key'
if key in cfg:
    print(cfg[key])
else:
    print(f'Key not found: {key}', file=sys.stderr)
    sys.exit(1)
"
}

cmd_config_set() {
  local key=$1 value=$2
  local result
  result=$($CURL -X POST -H 'Content-Type: application/json' \
    -d "{\"config\":{\"$key\":\"$value\"}}" "$API/admin/save") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$result" | python3 -c "
import sys, json
r = json.load(sys.stdin)
if r.get('ok'):
    saved = r.get('saved', [])
    applied = r.get('applied', {})
    if not saved:
        print(f'Error: key \"$key\" is not a valid config key', file=sys.stderr)
        sys.exit(1)
    print(f'Set $key = $value')
    for k, v in applied.items():
        print(f'  Applied: {k}')
else:
    print(f'Error: {r.get(\"error\", \"unknown\")}', file=sys.stderr)
    sys.exit(1)
"
}

cmd_config_keys() {
  cat <<'KEYS'
node_hostname         Hostname prefix
mesh_ssid             Mesh network SSID
mesh_key              Mesh SAE (WPA3) key
ipv4_network          Mesh IPv4 subnet
regulatory_domain     WiFi regulatory domain (US, EU, JP, AU)
halow_bw              HaLow bandwidth (1MHz, 2MHz, 4MHz, 8MHz)
multicast_mode        Multicast: flood (default) or optimized
eud                   EUD mode: wired, wireless, both, auto, none
lan_ap_ssid           WiFi AP SSID
lan_ap_key            WiFi AP password
lan_ap_channel        AP channel
lan_ap_bw             AP bandwidth (20, 40, 80)
max_euds_per_node     Max EUD clients per node
acs                   Auto channel selection (y/n)
battery_monitor       Battery monitoring (y/n)
auto_update           Auto update (y/n)
admin_password        Admin/perf auth key
gateway               Gateway mode (y/n)
gateway_nat           NAT masquerade (y/n)
gateway_mss_clamp     MSS clamping (y/n)
gateway_bandwidth     Bandwidth advertisement (e.g. 5M/5M)
KEYS
}

cmd_radio_info() {
  local d
  d=$($CURL "$API/local") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
ifaces = d.get('interfaces', [])
radios = [i for i in ifaces if i.get('role') in ('mesh', 'ap') or i.get('driver')]
if not radios:
    print('No radios detected')
    sys.exit(0)
for r in radios:
    print(f\"--- {r['name']} [{r.get('state','?')}] ---\")
    print(f\"  Role:      {r.get('role', '--')}\")
    print(f\"  Driver:    {r.get('driver', '--')}\")
    if r.get('channel'): print(f\"  Channel:   {r['channel']}\")
    if r.get('freq_mhz'): print(f\"  Frequency: {r['freq_mhz']} MHz\")
    if r.get('halow_bw'): print(f\"  Bandwidth: {r['halow_bw']}\")
    if r.get('txpower_dbm'): print(f\"  TX Power:  {r['txpower_dbm']} dBm\")
    if r.get('tx_mcs'): print(f\"  TX MCS:    {r['tx_mcs']}\")
    if r.get('rx_mcs'): print(f\"  RX MCS:    {r['rx_mcs']}\")
    if r.get('addrs'): print(f\"  Addresses: {', '.join(r['addrs'])}\")
    if r.get('faults'): print(f\"  Faults:    {', '.join(r['faults'])}\")
    print()
"
}

cmd_radio_txpower() {
  local iface=$1 dbm=$2
  $CURL -X POST -H 'Content-Type: application/json' \
    -d "{\"interface\":\"$iface\",\"dbm\":$dbm}" "$API/control/txpower" | python3 -c "
import sys, json
r = json.load(sys.stdin)
if r.get('ok'): print(f'TX power set to {$dbm} dBm on $iface')
else: print(f'Error: {r.get(\"error\", \"unknown\")}'); sys.exit(1)
"
}

cmd_radio_interface() {
  local iface=$1 action=$2
  $CURL -X POST -H 'Content-Type: application/json' \
    -d "{\"name\":\"$iface\",\"action\":\"$action\"}" "$API/control/interface" | python3 -c "
import sys, json
r = json.load(sys.stdin)
if r.get('ok'): print(f'Interface $iface set to $action')
else: print(f'Error: {r.get(\"error\", \"unknown\")}'); sys.exit(1)
"
}

cmd_gps() {
  local d
  d=$($CURL "$API/local") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
gps = d.get('gps', {})
if gps and gps.get('available'):
    print(f\"Status:    Fix acquired\")
    print(f\"Latitude:  {gps.get('lat', '--')}\")
    print(f\"Longitude: {gps.get('lon', '--')}\")
    print(f\"Altitude:  {gps.get('alt', '--')} m\")
else:
    print('Status:    No GPS fix or device not connected')
"
}

cmd_services() {
  local d
  d=$($CURL "$API/services") || { echo "Error: cannot reach manet-ctrl API"; exit 1; }
  echo "$d" | python3 -c "
import sys, json
d = json.load(sys.stdin)
svcs = d.get('services', [])
fmt = '{:<20s} {:<12s} {:<12s} {:<10s}'
print(fmt.format('SERVICE', 'STATUS', 'CATEGORY', 'ENABLED'))
print('-' * 56)
for s in svcs:
    print(fmt.format(
        s.get('name', '?')[:20],
        s.get('status', '?'),
        s.get('category', '?'),
        'yes' if s.get('enabled') else 'no'
    ))
"
}

cmd_perf_ping() {
  local target=$1
  $CURL -X POST -H 'Content-Type: application/json' \
    -d "{\"target\":\"$target\",\"count\":10}" "$API/perf/ping/run" >/dev/null 2>&1 || true
  $CURL "$API/perf/ping/stream" 2>/dev/null || ping -c 10 "$target"
}

cmd_reboot() {
  echo "Rebooting node..."
  $CURL -X POST -H 'Content-Type: application/json' -d '{}' "$API/terminal/reboot" >/dev/null 2>&1 || true
  echo "Reboot command sent."
}

case "${1:-}" in
  status)    cmd_status ;;
  nodes)     cmd_nodes ;;
  config)
    case "${2:-}" in
      show) cmd_config_show ;;
      get)
        [[ $# -ge 3 ]] || { echo "Usage: mesh config get <key>"; exit 1; }
        cmd_config_get "$3" ;;
      set)
        [[ $# -ge 4 ]] || { echo "Usage: mesh config set <key> <value>"; exit 1; }
        cmd_config_set "$3" "$4" ;;
      keys) cmd_config_keys ;;
      *)    echo "Usage: mesh config {show|get|set|keys}"; exit 1 ;;
    esac ;;
  radio)
    case "${2:-}" in
      info) cmd_radio_info ;;
      txpower)
        [[ $# -ge 4 ]] || { echo "Usage: mesh radio txpower <iface> <dbm>"; exit 1; }
        cmd_radio_txpower "$3" "$4" ;;
      interface)
        [[ $# -ge 4 ]] || { echo "Usage: mesh radio interface <iface> up|down"; exit 1; }
        cmd_radio_interface "$3" "$4" ;;
      *)  echo "Usage: mesh radio {info|txpower|interface}"; exit 1 ;;
    esac ;;
  gps)       cmd_gps ;;
  services)  cmd_services ;;
  perf)
    case "${2:-}" in
      ping)
        [[ $# -ge 3 ]] || { echo "Usage: mesh perf ping <target>"; exit 1; }
        cmd_perf_ping "$3" ;;
      *)  echo "Usage: mesh perf ping <target>"; exit 1 ;;
    esac ;;
  reboot)    cmd_reboot ;;
  help|--help|-h|"") usage ;;
  *)  echo "Unknown command: $1"; usage; exit 1 ;;
esac
