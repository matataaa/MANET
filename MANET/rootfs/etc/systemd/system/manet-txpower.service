[Unit]
Description=Request 30 dBm on mesh radios, with no MANET power ceiling
# Every mesh radio, Wi-Fi and HaLow, per PHY; see manet-txpower.sh. HaLow is
# enslaved to bat0 after its supplicant starts, so by then it is up and on
# its channel.
After=batman-enslave.service wpa_supplicant@wlan0.service wpa_supplicant@wlan1.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 5
ExecStart=/usr/local/bin/manet-txpower.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
