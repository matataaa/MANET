[Unit]
Description=Waveshare UPS HAT battery monitor (auto-detects HAT E / IP2368 or HAT B / INA219)
Documentation=https://www.waveshare.com/wiki/UPS_HAT_(E) https://www.waveshare.com/wiki/UPS_HAT_(B)
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/battery-reader
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=battery-reader

[Install]
WantedBy=multi-user.target
