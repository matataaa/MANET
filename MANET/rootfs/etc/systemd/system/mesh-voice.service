[Unit]
Description=Mesh Voice PTT over multicast
After=network.target batman-enslave.service
Wants=batman-enslave.service

[Service]
Type=simple
# Interface, PTT mode and channel come from /etc/mesh.conf (voice_iface,
# voice_ptt_mode, voice_channel); manet-ctrl edits those and restarts.
ExecStart=/usr/local/bin/mesh-voice
Restart=on-failure
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
