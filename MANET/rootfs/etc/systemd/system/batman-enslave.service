# Placeholder — radio-setup.sh rewrites this with the actual detected interfaces.
# This minimal version lets the tarball extract cleanly on first boot before
# radio-setup has run; it only depends on the HaLow radio (always present).
[Unit]
Description=BATMAN Advanced Interface Manager
After=network-online.target manet-wlan-apply-link-names.service sys-subsystem-net-devices-wlan2.device wpa_supplicant-s1g-wlan2.service
Wants=network-online.target wpa_supplicant-s1g-wlan2.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 6
ExecStart=/usr/local/bin/batman-if-setup.sh start
ExecStop=/usr/local/bin/batman-if-setup.sh stop

[Install]
WantedBy=multi-user.target
