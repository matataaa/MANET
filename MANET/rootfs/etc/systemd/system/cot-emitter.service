[Unit]
Description=CoT SA emitter — GPS to ATAK EUDs
After=gps-reader.service
Wants=gps-reader.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cot-emitter
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cot-emitter

[Install]
WantedBy=multi-user.target
