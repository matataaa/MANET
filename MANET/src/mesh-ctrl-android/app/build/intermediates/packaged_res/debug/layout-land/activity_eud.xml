<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="6dp">

    <!-- Main content: side-by-side in landscape -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: LCD screen (2/3 normally, shrinks when channel grid visible) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:background="@drawable/eud_lcd_bg"
            android:padding="10dp">

            <!-- Header: page title + status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/eud_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="── RADIO ──"
                    android:textColor="#33ff33"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:shadowColor="#33ff33"
                    android:shadowRadius="6"
                    android:shadowDx="0"
                    android:shadowDy="0"/>

                <TextView
                    android:id="@+id/eud_conn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="■"
                    android:textColor="#33ff33"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:shadowColor="#33ff33"
                    android:shadowRadius="4"
                    android:shadowDx="0"
                    android:shadowDy="0"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1a3a1a"
                android:layout_marginVertical="3dp"/>

            <!-- Main display content -->
            <TextView
                android:id="@+id/eud_display"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top"
                android:textColor="#33ff33"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:shadowColor="#33ff33"
                android:shadowRadius="3"
                android:shadowDx="0"
                android:shadowDy="0"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1a3a1a"
                android:layout_marginVertical="3dp"/>

            <!-- Footer: page dots + timestamp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/eud_pages"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● ○ ○ ○"
                    android:textColor="#33ff33"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:shadowColor="#33ff33"
                    android:shadowRadius="4"
                    android:shadowDx="0"
                    android:shadowDy="0"/>

                <TextView
                    android:id="@+id/eud_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1a8a1a"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Right panel: channel grid + voice controls (COMMS page only, 1/3 width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:gravity="center">

            <!-- Channel grid -->
            <LinearLayout
                android:id="@+id/eud_channel_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <!-- Voice controls -->
            <LinearLayout
                android:id="@+id/eud_voice_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:visibility="gone">

                <Button
                    android:id="@+id/eud_btn_mic_down"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/eud_btn_bg"
                    android:text="MIC-"
                    android:textColor="#33ff33"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/eud_btn_mic_up"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/eud_btn_bg"
                    android:text="MIC+"
                    android:textColor="#33ff33"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/eud_btn_vol_down"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/eud_btn_bg"
                    android:text="VOL-"
                    android:textColor="#33ff33"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/eud_btn_vol_up"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/eud_btn_bg"
                    android:text="VOL+"
                    android:textColor="#33ff33"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Page nav buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center">

        <Button
            android:id="@+id/eud_nav_radio"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="RADIO"
            android:textColor="#33ff33"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_mesh"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="MESH"
            android:textColor="#33ff33"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_comms"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="COMMS"
            android:textColor="#33ff33"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_stat"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="STAT"
            android:textColor="#33ff33"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_exit"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="HOME"
            android:textColor="#33ff33"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

    </LinearLayout>

</LinearLayout>
