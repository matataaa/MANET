<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <!-- LCD Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/eud_lcd_bg"
        android:padding="12dp">

        <!-- Header: page title + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/eud_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="── RADIO ──"
                android:textColor="#33ff33"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:shadowColor="#33ff33"
                android:shadowRadius="6"
                android:shadowDx="0"
                android:shadowDy="0"/>

            <TextView
                android:id="@+id/eud_conn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="■"
                android:textColor="#33ff33"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:shadowColor="#33ff33"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1a3a1a"
            android:layout_marginVertical="4dp"/>

        <!-- Main display content -->
        <TextView
            android:id="@+id/eud_display"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:textColor="#33ff33"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:shadowColor="#33ff33"
            android:shadowRadius="3"
            android:shadowDx="0"
            android:shadowDy="0"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1a3a1a"
            android:layout_marginVertical="4dp"/>

        <!-- Footer: page dots + timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/eud_pages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● ○ ○ ○"
                android:textColor="#33ff33"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:shadowColor="#33ff33"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>

            <TextView
                android:id="@+id/eud_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1a8a1a"
                android:textSize="11sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Chat input (CHAT page only) -->
    <LinearLayout
        android:id="@+id/eud_chat_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/eud_chat_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/eud_input_bg"
            android:textColor="#33ff33"
            android:textColorHint="#1a5a1a"
            android:hint="Message..."
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:singleLine="true"
            android:importantForAutofill="no"/>

        <Button
            android:id="@+id/eud_chat_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="64dp"
            android:background="@drawable/eud_btn_bg"
            android:text="SEND"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

    </LinearLayout>

    <!-- Channel grid (COMMS page only) -->
    <LinearLayout
        android:id="@+id/eud_channel_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:visibility="gone"/>

    <!-- Voice controls (COMMS page only) -->
    <LinearLayout
        android:id="@+id/eud_voice_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:visibility="gone">

        <Button
            android:id="@+id/eud_btn_mic_down"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="MIC-"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_btn_mic_up"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="MIC+"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_btn_vol_down"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="VOL-"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_btn_vol_up"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="VOL+"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

    </LinearLayout>

    <!-- Page nav buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center">

        <Button
            android:id="@+id/eud_nav_radio"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="RADIO"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_mesh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="MESH"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_comms"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="COMMS"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_stat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="STAT"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_chat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="CHAT"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/eud_nav_exit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/eud_btn_bg"
            android:text="HOME"
            android:textColor="#33ff33"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="false"/>

    </LinearLayout>

</LinearLayout>
