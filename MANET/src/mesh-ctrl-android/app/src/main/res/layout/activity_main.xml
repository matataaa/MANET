<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#1A1D27">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#E4E4E7"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:tint="#6B7280"/>

        <ImageButton
            android:id="@+id/btn_eud"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="EUD Mode"
            android:tint="#00928F"/>

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:tint="#6B7280"/>

        <ImageButton
            android:id="@+id/btn_node"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_mapmode"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Switch node"
            android:tint="#6B7280"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/toolbar"
        android:max="100"
        android:progressTint="#3B82F6"
        android:progressBackgroundTint="#2A2D3A"/>

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progress"/>

    <TextView
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progress"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#EF4444"
        android:textSize="14sp"
        android:visibility="gone"/>

</RelativeLayout>
