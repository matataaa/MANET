*.img
*.deb
*.img.xz
.DS_Store
._*
.cursor/mesh-nodes.env

# ---------------------------------------------------------------------------
# Build OUTPUT only. Anything the build consumes as an INPUT stays tracked:
#   MANET/binaries_arm64/*              (alfred, batctl, wpa_supplicant_s1g, ...)
#   MANET/src/mesh-voice/bin/*          (prebuilt CGO binaries — cannot cross-compile)
#   MANET/provisioning/*.exe            (Windows flashing helpers)
#   MANET/rootfs/root/regulatory.db     (shipped to the node)
# ---------------------------------------------------------------------------

# Packaged tarballs — regenerate with MANET/packaging/build-*-tarball.sh
MANET/install_packages/*.tar.gz

# Cross-compiled Go services — regenerate with the packaging scripts
MANET/src/battery-reader/battery-reader
MANET/src/cot-emitter/cot-emitter
MANET/src/gateway-manager/gateway-manager
MANET/src/gps-reader/gps-reader
MANET/src/halow-mcs-summary/halow-mcs-summary
MANET/src/manet-ctrl/manet-ctrl
MANET/src/mesh-chat/mesh-chat
MANET/src/mesh-manager/mesh-manager
MANET/src/mesh-radio-state/mesh-radio-state
MANET/src/mesh-registry/mesh-registry
MANET/src/node-manager/node-manager

# Local dev builds (host-native, never shipped)
MANET/src/manet-ctrl/manet-term
MANET/src/mesh-cli/mesh-cli
MANET/src/manet-ctrl/bin/
MANET/src/gateway-manager/bin/

# Android build artifacts
MANET/src/mesh-ctrl-android/.gradle/
MANET/src/mesh-ctrl-android/app/build/

# Provisioning scratch
MANET/provisioning/.image-cache/
